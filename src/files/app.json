{
  "id": "files",
  "version": "1.1.0",
  "kind": "local",
  "name": "File Manager",
  "description": "Sfoglia, cerca e organizza file e cartelle: tag, collegamenti, cestino, informazioni e anteprima.",
  "category": "system",
  "icon": { "glyph": "folder", "color": "#3b6ef5" },
  "publisher": { "id": "lilos", "name": "lilOS" },
  "sdk": "1",
  "system": true,
  "required": true,
  "permissions": ["fs.write:~", "fs.workspaces", "tags.write", "desktop.items", "ui.shortcuts"],
  "contributes": {
    "window": { "width": 1000, "height": 520 },
    "commands": [
      { "id": "files.info", "label": "Mostra o nascondi le informazioni", "keys": ["Alt+I"] },
      { "id": "files.preview", "label": "Mostra o nascondi l’anteprima", "keys": ["Alt+P"] }
    ]
  }
}
