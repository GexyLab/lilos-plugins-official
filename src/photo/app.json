{
  "id": "photo",
  "version": "1.0.0",
  "kind": "local",
  "name": "Photo",
  "description": "Guarda le immagini e le ritocca: disegno, testo, ritaglio, ridimensionamento e conversione in PNG, JPEG o WebP.",
  "category": "media",
  "icon": { "glyph": "image", "color": "#e5734d" },
  "publisher": { "id": "lilos", "name": "lilOS" },
  "sdk": "1",
  "system": true,
  "permissions": ["fs.write:~", "ui.shortcuts"],
  "contributes": {
    "window": { "width": 900, "height": 620 },
    "fileTypes": ["png", "jpg", "jpeg", "gif", "webp", "bmp", "avif", "ico", "svg"],
    "commands": [
      { "id": "photo.save", "label": "Salva", "keys": ["Ctrl+S"] },
      { "id": "photo.open", "label": "Apri un’immagine", "keys": ["Ctrl+O"] }
    ]
  }
}
