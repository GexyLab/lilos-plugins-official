{
  "id": "photo",
  "version": "1.2.0",
  "kind": "local",
  "name": "Photo",
  "description": "View and touch up images: drawing, text, cropping, resizing and conversion to PNG, JPEG or WebP.",
  "category": "media",
  "icon": { "glyph": "image", "color": "#e5734d" },
  "publisher": { "id": "lilos", "name": "lilOS" },
  "sdk": "2",
  "system": true,
  "entrypoints": {
    "main": { "kind": "window", "params": {
      "file": {"type": "file", "label": "Image", "description": "The image to open"}
    } },
    "filePreview": { "kind": "background", "label": "Image previews" }
  },
  "permissions": ["fs.write:~", "ui.shortcuts"],
  "contributes": {
    "window": { "width": 900, "height": 620 },
    "fileTypes": ["png", "jpg", "jpeg", "gif", "webp", "bmp", "avif", "ico", "svg"],
    "commands": [
      { "id": "photo.save", "label": "Save", "keys": ["Ctrl+S"] },
      { "id": "photo.open", "label": "Open an image", "keys": ["Ctrl+O"] }
    ]
  }
}
