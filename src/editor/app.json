{
  "id": "editor",
  "version": "1.0.2",
  "kind": "local",
  "name": "Editor",
  "description": "Editor di testo e codice con evidenziazione, suggerimenti e controllo di JSON, CSS e HTML.",
  "category": "development",
  "icon": { "glyph": "code", "color": "#7c5cdb" },
  "publisher": { "id": "lilos", "name": "lilOS" },
  "sdk": "1",
  "system": true,
  "entrypoints": { "main": { "kind": "window", "params": {
    "file": {"type": "file", "label": "File", "description": "Il file da aprire"},
    "folder": {"type": "folder", "label": "Cartella", "description": "La cartella nel pannello a destra"}
  } } },
  "permissions": ["fs.write:~", "ui.shortcuts", "net:https://json.schemastore.org"],
  "contributes": {
    "window": { "width": 900, "height": 600 },
    "fileTypes": ["", "txt", "md", "markdown", "log", "csv", "json", "js", "mjs", "cjs", "ts", "css", "html", "htm", "xml", "svg", "py", "sh", "yml", "yaml", "ini", "toml", "env"],
    "commands": [
      { "id": "editor.save", "label": "Salva", "keys": ["Ctrl+S"] },
      { "id": "editor.new", "label": "Nuovo documento", "keys": ["Ctrl+Alt+N"] },
      { "id": "editor.openFile", "label": "Apri un file", "keys": ["Ctrl+O"] },
      { "id": "editor.openFolder", "label": "Apri una cartella", "keys": ["Ctrl+Alt+O"] },
      { "id": "editor.sidebar", "label": "Mostra o nascondi la cartella", "keys": ["Ctrl+B"] },
      { "id": "editor.complete", "label": "Mostra i suggerimenti", "keys": ["Ctrl+Space"] }
    ]
  }
}
