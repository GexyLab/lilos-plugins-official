{
  "id": "editor",
  "version": "1.1.0",
  "kind": "local",
  "name": "Editor",
  "description": "Text and code editor with syntax highlighting, suggestions and checking of JSON, CSS and HTML.",
  "category": "development",
  "icon": { "glyph": "code", "color": "#7c5cdb" },
  "publisher": { "id": "lilos", "name": "lilOS" },
  "sdk": "1",
  "system": true,
  "entrypoints": { "main": { "kind": "window", "params": {
    "file": {"type": "file", "label": "File", "description": "The file to open"},
    "folder": {"type": "folder", "label": "Folder", "description": "The folder in the panel on the right"}
  } } },
  "permissions": ["fs.write:~", "ui.shortcuts", "net:https://json.schemastore.org"],
  "contributes": {
    "window": { "width": 900, "height": 600 },
    "fileTypes": ["", "txt", "md", "markdown", "log", "csv", "json", "js", "mjs", "cjs", "ts", "css", "html", "htm", "xml", "svg", "py", "sh", "yml", "yaml", "ini", "toml", "env"],
    "commands": [
      { "id": "editor.save", "label": "Save", "keys": ["Ctrl+S"] },
      { "id": "editor.new", "label": "New document", "keys": ["Ctrl+Alt+N"] },
      { "id": "editor.openFile", "label": "Open file", "keys": ["Ctrl+O"] },
      { "id": "editor.openFolder", "label": "Open folder", "keys": ["Ctrl+Alt+O"] },
      { "id": "editor.sidebar", "label": "Show or hide folder", "keys": ["Ctrl+B"] },
      { "id": "editor.complete", "label": "Show suggestions", "keys": ["Ctrl+Space"] }
    ]
  }
}
