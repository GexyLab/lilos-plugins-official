{
  "id": "photo",
  "version": "1.0.1",
  "kind": "local",
  "name": "Photo",
  "description": "Guarda le immagini e le ritocca: disegno, testo, ritaglio, ridimensionamento e conversione in PNG, JPEG o WebP.",
  "category": "media",
  "icon": {
    "glyph": "image",
    "color": "#e5734d"
  },
  "publisher": {
    "id": "lilos",
    "name": "lilOS"
  },
  "sdk": "1",
  "system": true,
  "entrypoints": {
    "main": {
      "kind": "window",
      "params": {
        "file": {
          "type": "file",
          "label": "Immagine",
          "description": "L’immagine da aprire"
        }
      }
    }
  },
  "permissions": [
    "fs.write:~",
    "ui.shortcuts"
  ],
  "contributes": {
    "window": {
      "width": 900,
      "height": 620
    },
    "fileTypes": [
      "png",
      "jpg",
      "jpeg",
      "gif",
      "webp",
      "bmp",
      "avif",
      "ico",
      "svg"
    ],
    "commands": [
      {
        "id": "photo.save",
        "label": "Salva",
        "keys": [
          "Ctrl+S"
        ]
      },
      {
        "id": "photo.open",
        "label": "Apri un’immagine",
        "keys": [
          "Ctrl+O"
        ]
      }
    ]
  },
  "entry": "dist/index.js",
  "styles": [
    "dist/index-DqF2jp_v.css"
  ],
  "files": {
    "dist/index-DqF2jp_v.css": "sha256-oS0F1fKhzl/FkJd+jrJN0LQYEA6u+UPHsDthL9/3zmE=",
    "dist/index.js": "sha256-PcegCFPeZ7ZY8StDby3N61NaR5+o0XV7QKfXHVfsTSU="
  }
}
