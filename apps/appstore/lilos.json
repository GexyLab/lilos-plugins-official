{
  "id": "appstore",
  "version": "1.10.0",
  "kind": "local",
  "name": "AppStore",
  "description": "Installs, updates and removes apps and kernel modules from repositories; checks for updates even with lilOS closed.",
  "category": "system",
  "icon": {
    "glyph": "download",
    "color": "#30a46c"
  },
  "publisher": {
    "id": "lilos",
    "name": "lilOS"
  },
  "sdk": "1",
  "system": true,
  "required": true,
  "lilos": ">=1.22.0",
  "entrypoints": {
    "updates": {
      "kind": "service",
      "file": "dist/updates.js",
      "label": "Updates",
      "params": {
        "ore": {
          "type": "number",
          "label": "Check every (hours)",
          "min": 1,
          "max": 168,
          "default": 24
        }
      }
    }
  },
  "permissions": [
    "apps.manage",
    "background"
  ],
  "contributes": {
    "window": {
      "width": 860,
      "height": 600
    }
  },
  "entry": "dist/index.js",
  "styles": [
    "dist/index-84c52REl.css"
  ],
  "locales": "locales.json",
  "files": {
    "dist/index-84c52REl.css": "sha256-EQGy8HlVhcNzuhVAnb3QG6+Yx8VF9m4YgWZcKyKNq2c=",
    "dist/index.js": "sha256-81khecvAaCmEZxQU+o8OVh+BjoT90fnU2+/jz27yvqo=",
    "dist/updates.js": "sha256-ptwldS84ZrgUntI37eh8M3XjsVxDYZQHOnUy8SNfrtU=",
    "locales.json": "sha256-1LISMNVD0qqV1IypD46H6nfRvx38DgOUVw7+atvomvE="
  }
}
