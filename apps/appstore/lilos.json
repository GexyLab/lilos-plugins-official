{
  "id": "appstore",
  "version": "1.9.0",
  "kind": "local",
  "name": "AppStore",
  "description": "Installs, updates and removes apps and kernel modules from repositories; checks for updates even with lilOS closed.",
  "category": "system",
  "icon": {
    "glyph": "download",
    "color": "#30a46c"
  },
  "publisher": {
    "id": "lilos",
    "name": "lilOS"
  },
  "sdk": "1",
  "system": true,
  "required": true,
  "entrypoints": {
    "updates": {
      "kind": "service",
      "file": "dist/updates.js",
      "label": "Updates",
      "params": {
        "ore": {
          "type": "number",
          "label": "Check every (hours)",
          "min": 1,
          "max": 168,
          "default": 24
        }
      }
    }
  },
  "permissions": [
    "apps.manage",
    "background"
  ],
  "contributes": {
    "window": {
      "width": 860,
      "height": 600
    }
  },
  "entry": "dist/index.js",
  "styles": [
    "dist/index-CSUXK4Uy.css"
  ],
  "locales": "locales.json",
  "files": {
    "dist/index-CSUXK4Uy.css": "sha256-vZRcQ4KvHGxr9PuhI6RU5RHmYqWMAg5FIM6JkY9HUV0=",
    "dist/index.js": "sha256-MtRG8w5NbhmJaj3r13ystqyr6h/R/pJ28LdBDzb+JH8=",
    "dist/updates.js": "sha256-ptwldS84ZrgUntI37eh8M3XjsVxDYZQHOnUy8SNfrtU=",
    "locales.json": "sha256-7+X9wesZMwNG8BWfZTZpEsKpg8odECJQuvNqXxZ9T7c="
  }
}
