{
  "id": "appstore",
  "version": "1.7.0",
  "kind": "local",
  "name": "AppStore",
  "description": "Installs, updates and removes apps and kernel modules from repositories; checks for updates even with lilOS closed.",
  "category": "system",
  "icon": {
    "glyph": "download",
    "color": "#30a46c"
  },
  "publisher": {
    "id": "lilos",
    "name": "lilOS"
  },
  "sdk": "1",
  "system": true,
  "required": true,
  "entrypoints": {
    "updates": {
      "kind": "service",
      "file": "dist/updates.js",
      "label": "Updates",
      "params": {
        "ore": {
          "type": "number",
          "label": "Check every (hours)",
          "min": 1,
          "max": 168,
          "default": 24
        }
      }
    }
  },
  "permissions": [
    "apps.manage",
    "background"
  ],
  "contributes": {
    "window": {
      "width": 860,
      "height": 600
    }
  },
  "entry": "dist/index.js",
  "styles": [
    "dist/index-BI4EHm56.css"
  ],
  "locales": "locales.json",
  "files": {
    "dist/index-BI4EHm56.css": "sha256-5q2fc19quKv8F4sM3BSZEANdC0p2E426wEejxqxAsqM=",
    "dist/index.js": "sha256-a/bJfYa57alUkEa0BHlyH6OkpePoRbwKVRtnPMkSR+c=",
    "dist/updates.js": "sha256-Pdt2pQyfg33lee8BTWaCYGpGx4RCwc7aiWjfIyM6sOU=",
    "locales.json": "sha256-ol0CbTZv2e0/v7Dtp7M8kFbLzvC9RPZbbdGtqPPtAsI="
  }
}
