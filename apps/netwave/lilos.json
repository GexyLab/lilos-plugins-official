{
  "id": "netwave",
  "version": "1.2.0",
  "kind": "local",
  "name": "NetWave Browser",
  "description": "A web browser for lilOS: tabs in as many windows as you want, each window saved as a session with all its tabs, and a history of the pages and of the sessions opened. The pages run isolated from lilOS, in the lilOS program.",
  "category": "productivity",
  "icon": {
    "glyph": "globe",
    "color": "#1f8fbf"
  },
  "publisher": {
    "id": "lilos",
    "name": "lilOS"
  },
  "sdk": "2",
  "lilos": ">=1.38.0",
  "system": true,
  "entrypoints": {
    "main": {
      "kind": "window",
      "params": {
        "url": {
          "type": "text",
          "label": "Address",
          "description": "A web page to open"
        },
        "file": {
          "type": "file",
          "label": "Session",
          "description": "A NetWave session (.nwsession) to open"
        }
      }
    },
    "filePreview": {
      "kind": "background",
      "label": "Previews of .nwsession sessions"
    }
  },
  "permissions": [
    "fs.write:~"
  ],
  "contributes": {
    "window": {
      "width": 1100,
      "height": 720
    },
    "fileTypes": [
      "nwsession"
    ]
  },
  "entry": "dist/index.js",
  "styles": [
    "dist/index-Csmk1tjz.css"
  ],
  "locales": "locales.json",
  "files": {
    "dist/browser-DOmFCJVN.js": "sha256-XnfD1iyw6CqiYnLsUKKFhy8h3j679bsBYLLZJ1Kg/Jw=",
    "dist/historyWindow-DoPit6Wn.js": "sha256-2iba5k2nBNMCtAmSqGAz447OwSgYi8iNT5unuUAK6Bo=",
    "dist/i18n-DkMmN531.js": "sha256-nl2BoIb2c/i4baSkGNWJSif/y2YOd612mSSlRTOHbi4=",
    "dist/index-Csmk1tjz.css": "sha256-VTuqdQKVcOot8+zk4VfzeVRCr0Zm2i5dhTV8vlMgCxo=",
    "dist/index.js": "sha256-7mctfwns8b6t1ZZS3fNBZD5ZlBg07DV07S10jDc6Cmc=",
    "dist/optionsWindow-D1eeltzP.js": "sha256-BABe6PuolkO7lyJkZ99pz9kJdZOXnPq/oTJ3WcL+oJ4=",
    "locales.json": "sha256-0h/wFO2Gqu9JFDLbXQgYGmaI5Byzo1de20yqs6fS9T0="
  }
}
