{
  "id": "netwave",
  "version": "1.1.0",
  "kind": "local",
  "name": "NetWave Browser",
  "description": "A web browser for lilOS: tabs in as many windows as you want, each window saved as a session with all its tabs, and a history of the pages and of the sessions opened. The pages run isolated from lilOS, in the lilOS program.",
  "category": "productivity",
  "icon": {
    "glyph": "globe",
    "color": "#1f8fbf"
  },
  "publisher": {
    "id": "lilos",
    "name": "lilOS"
  },
  "sdk": "2",
  "lilos": ">=1.38.0",
  "system": true,
  "entrypoints": {
    "main": {
      "kind": "window",
      "params": {
        "url": {
          "type": "text",
          "label": "Address",
          "description": "A web page to open"
        },
        "file": {
          "type": "file",
          "label": "Session",
          "description": "A NetWave session (.nwsession) to open"
        }
      }
    },
    "filePreview": {
      "kind": "background",
      "label": "Previews of .nwsession sessions"
    }
  },
  "permissions": [
    "fs.write:~"
  ],
  "contributes": {
    "window": {
      "width": 1100,
      "height": 720
    },
    "fileTypes": [
      "nwsession"
    ]
  },
  "entry": "dist/index.js",
  "styles": [
    "dist/index-Csmk1tjz.css"
  ],
  "locales": "locales.json",
  "files": {
    "dist/browser-DmwxbmZ7.js": "sha256-n33+LI3noUPxTPbCBqcSQw+kFTI1BNUp2PDWdh1okKU=",
    "dist/historyWindow-CnmI78mC.js": "sha256-iYK2VDkDyjg9e3CGnBXpJ9HliltuDMG/cWEBkqH6l9E=",
    "dist/i18n-BNs41huj.js": "sha256-wK3Q8Yg4y1WYO2VOJhmQx1mzID96meOCmaABQQLlIr8=",
    "dist/index-Csmk1tjz.css": "sha256-VTuqdQKVcOot8+zk4VfzeVRCr0Zm2i5dhTV8vlMgCxo=",
    "dist/index.js": "sha256-cgTWW82FmyskqUHgDMmBk1+wr42ak+e8xT7U4CY4lWM=",
    "dist/optionsWindow-DQvCvYJ8.js": "sha256-JukzGTgCYXNZgq4x7W5pN1QG6XYBoBuAx4yZoCqwmJk=",
    "locales.json": "sha256-KBro3QbDfFPNi8ykyZiVbD5y1U978K++CpMFivSWuwk="
  }
}
