{
  "id": "terminal",
  "version": "1.1.1",
  "kind": "local",
  "name": "Terminal",
  "description": "A bash-like shell over the files of lilOS: commands, pipes, redirections, variables, loops, functions and scripts.",
  "category": "development",
  "icon": {
    "glyph": "terminal",
    "color": "#2b3038"
  },
  "publisher": {
    "id": "lilos",
    "name": "lilOS"
  },
  "sdk": "1",
  "system": true,
  "entrypoints": {
    "main": {
      "kind": "window",
      "params": {
        "cwd": {
          "type": "folder",
          "label": "Folder",
          "description": "The folder to open the terminal in"
        }
      }
    }
  },
  "permissions": [
    "fs.write:~",
    "tags.write"
  ],
  "contributes": {
    "window": {
      "width": 760,
      "height": 460
    }
  },
  "entry": "dist/index.js",
  "styles": [
    "dist/index-cS4PAZr0.css"
  ],
  "locales": "locales.json",
  "files": {
    "dist/index-cS4PAZr0.css": "sha256-daR1N0U/TT0z8XFY0XTTGR7kLV0idwTdyhg2tGpAqb0=",
    "dist/index.js": "sha256-V0EKxtW6aO4BvNxkmwJGeYaLWA3eYxZ12qCOAHH5pcg=",
    "locales.json": "sha256-UeIHKrUlapGIVKjV77MH0qjy8CVxem1yxqvKYjLtu9Q="
  }
}
