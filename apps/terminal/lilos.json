{
  "id": "terminal",
  "version": "1.5.0",
  "kind": "local",
  "name": "Terminal",
  "description": "A bash-like shell over the files of lilOS, in tabs and panes side by side, and remote sessions: SSH, Telnet, rlogin and SUPDUP, with saved hosts, .term links and sessions that keep running when the window is closed.",
  "category": "development",
  "icon": {
    "glyph": "terminal",
    "color": "#2b3038"
  },
  "publisher": {
    "id": "lilos",
    "name": "lilOS"
  },
  "sdk": "2",
  "lilos": ">=1.16.0",
  "system": true,
  "entrypoints": {
    "main": {
      "kind": "window",
      "params": {
        "cwd": {
          "type": "folder",
          "label": "Folder",
          "description": "The folder to open the terminal in"
        },
        "file": {
          "type": "file",
          "label": "Link",
          "description": "A terminal link (.term) to open"
        }
      }
    },
    "filePreview": {
      "kind": "background",
      "label": "Previews of .term links"
    },
    "shell": {
      "kind": "service",
      "file": "dist/shell.js",
      "label": "Shell for the Scheduler"
    }
  },
  "permissions": [
    "fs.write:~",
    "tags.write",
    "term",
    "ui.menus",
    "ui.shortcuts",
    "background"
  ],
  "contributes": {
    "window": {
      "width": 760,
      "height": 460
    },
    "fileTypes": [
      "term"
    ],
    "commands": [
      {
        "id": "terminal.newShell",
        "label": "New shell",
        "keys": [
          "Alt+Shift+T"
        ]
      },
      {
        "id": "terminal.splitRight",
        "label": "Split right",
        "keys": [
          "Alt+Shift+D"
        ]
      },
      {
        "id": "terminal.splitDown",
        "label": "Split down",
        "keys": [
          "Alt+Shift+S"
        ]
      },
      {
        "id": "terminal.detach",
        "label": "Detach tab into a new window",
        "keys": [
          "Alt+Shift+W"
        ]
      },
      {
        "id": "terminal.broadcast",
        "label": "Send input to all panes",
        "keys": [
          "Alt+Shift+B"
        ]
      },
      {
        "id": "terminal.focusLeft",
        "label": "Pane on the left",
        "keys": [
          "Alt+Shift+ArrowLeft"
        ]
      },
      {
        "id": "terminal.focusRight",
        "label": "Pane on the right",
        "keys": [
          "Alt+Shift+ArrowRight"
        ]
      },
      {
        "id": "terminal.focusUp",
        "label": "Pane above",
        "keys": [
          "Alt+Shift+ArrowUp"
        ]
      },
      {
        "id": "terminal.focusDown",
        "label": "Pane below",
        "keys": [
          "Alt+Shift+ArrowDown"
        ]
      },
      {
        "id": "terminal.previousTab",
        "label": "Previous tab of the pane",
        "keys": [
          "Alt+Shift+PageUp"
        ]
      },
      {
        "id": "terminal.nextTab",
        "label": "Next tab of the pane",
        "keys": [
          "Alt+Shift+PageDown"
        ]
      },
      {
        "id": "terminal.moveLeft",
        "label": "Move tab to the left",
        "keys": [
          "Ctrl+Alt+Shift+ArrowLeft"
        ]
      },
      {
        "id": "terminal.moveRight",
        "label": "Move tab to the right",
        "keys": [
          "Ctrl+Alt+Shift+ArrowRight"
        ]
      },
      {
        "id": "terminal.moveUp",
        "label": "Move tab up",
        "keys": [
          "Ctrl+Alt+Shift+ArrowUp"
        ]
      },
      {
        "id": "terminal.moveDown",
        "label": "Move tab down",
        "keys": [
          "Ctrl+Alt+Shift+ArrowDown"
        ]
      }
    ],
    "actions": [
      {
        "id": "terminal.sshHere",
        "label": "Open SSH terminal here",
        "entry": "main",
        "on": "item",
        "glyph": "terminal",
        "when": {
          "net": [
            "sftp"
          ]
        }
      }
    ],
    "automation": [
      {
        "id": "terminal.run",
        "label": "Run a command",
        "target": "window",
        "params": {
          "command": {
            "type": "text",
            "label": "Command"
          },
          "folder": {
            "type": "folder",
            "label": "Folder",
            "description": "The working folder the command runs in"
          }
        }
      }
    ]
  },
  "entry": "dist/index.js",
  "styles": [
    "dist/index-Ljiteq9c.css"
  ],
  "locales": "locales.json",
  "files": {
    "dist/index-Ljiteq9c.css": "sha256-nyi/jlg1fYcJ9gF1wPaMzKly5IgrMa+Eht6fKre+MHM=",
    "dist/index.js": "sha256-qPyN0Cz7N4pRHkK7H+4g3biBd7x/Y/J/wPpIEtNgG1Y=",
    "dist/shell.js": "sha256-dxMxoktVXO92w+IR8qAu7elm/XNTZp2uHC4bp+6NxIc=",
    "locales.json": "sha256-9HWxzNQnkv5hR07tYE/cfrtuvpVjdZ1TqEFToAS0jBw="
  }
}
