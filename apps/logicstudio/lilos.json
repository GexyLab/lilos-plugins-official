{
  "id": "logicstudio",
  "version": "1.1.0",
  "kind": "local",
  "name": "Logic Studio IDE",
  "description": "Logic blocks linked together, as in OpenBack: schemas, projects with windows made of UI components, consoles. The engine runs them in lilOS, also with lilOS closed.",
  "category": "development",
  "icon": {
    "glyph": "blocks",
    "color": "#2da44e"
  },
  "publisher": {
    "id": "lilos",
    "name": "lilOS"
  },
  "sdk": "2",
  "system": true,
  "lilos": ">=1.37.0",
  "entrypoints": {
    "main": {
      "kind": "window"
    }
  },
  "dependencies": [
    {
      "module": "logicstudio-engine",
      "reason": "Runs the schemas and projects"
    },
    {
      "module": "logicstudio-core",
      "reason": "The base blocks"
    }
  ],
  "permissions": [
    "fs.write:~"
  ],
  "contributes": {
    "window": {
      "width": 1240,
      "height": 760
    },
    "fileTypes": [
      "lsproj",
      "lsch",
      "lsui",
      "lsapp"
    ]
  },
  "entry": "dist/index.js",
  "styles": [
    "dist/index-C8AAAX6k.css"
  ],
  "locales": "locales.json",
  "files": {
    "dist/index-C8AAAX6k.css": "sha256-AzcmSxmlGgIMWF6B/jPj2BZbMwbS3L9wj9yh9+21i28=",
    "dist/index.js": "sha256-TloAKn5SKooOufTv0r3Ce5XzMK2xFNPUb3m+fjIc034=",
    "locales.json": "sha256-wjjJcdOsQbvzU94urYrE/BIPgY/P8VvhhZPdnF/idi4="
  }
}
