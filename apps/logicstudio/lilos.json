{
  "id": "logicstudio",
  "version": "1.2.1",
  "kind": "local",
  "name": "Logic Studio IDE",
  "description": "Logic blocks linked together, as in OpenBack: schemas, projects with windows made of UI components, consoles. The engine runs them in lilOS, also with lilOS closed.",
  "category": "development",
  "icon": {
    "glyph": "blocks",
    "color": "#2da44e"
  },
  "publisher": {
    "id": "lilos",
    "name": "lilOS"
  },
  "sdk": "2",
  "system": true,
  "lilos": ">=1.39.0",
  "entrypoints": {
    "main": {
      "kind": "window"
    }
  },
  "dependencies": [
    {
      "module": "logicstudio-engine",
      "reason": "Runs the schemas and projects"
    },
    {
      "module": "logicstudio-core",
      "reason": "The base blocks"
    }
  ],
  "permissions": [
    "fs.write:~"
  ],
  "contributes": {
    "window": {
      "width": 1240,
      "height": 760
    },
    "fileTypes": [
      "lsproj",
      "lsch",
      "lsui",
      "lsapp"
    ]
  },
  "entry": "dist/index.js",
  "styles": [
    "dist/index-Di0W7ek6.css"
  ],
  "locales": "locales.json",
  "files": {
    "dist/index-Di0W7ek6.css": "sha256-72GIDGEyPnLxUMfglAu9U7dhb4E6WJoffBWeKVSlIyY=",
    "dist/index.js": "sha256-1+riuyYB8KRoOFSWLe+6L53QQjWpbaXcol55k95Yi6Q=",
    "locales.json": "sha256-ZagikgXprVSlzNHNbaGQLHuKnqFub1Tl6yx1h/ZI6Z8="
  }
}
