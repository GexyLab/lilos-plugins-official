{
  "id": "logicstudio",
  "version": "1.9.0",
  "kind": "local",
  "name": "Logic Studio IDE",
  "description": "Logic blocks linked together, as in OpenBack: schemas, projects with windows made of UI components, consoles. The engine runs them in lilOS, also with lilOS closed.",
  "category": "development",
  "icon": {
    "glyph": "blocks",
    "color": "#2da44e"
  },
  "publisher": {
    "id": "lilos",
    "name": "lilOS"
  },
  "sdk": "2",
  "system": true,
  "lilos": ">=1.43.0",
  "entrypoints": {
    "main": {
      "kind": "window"
    }
  },
  "dependencies": [
    {
      "module": "logicstudio-engine",
      "version": ">=1.4.0",
      "reason": "Runs the schemas and projects"
    },
    {
      "module": "logicstudio-core",
      "reason": "The base blocks"
    }
  ],
  "permissions": [
    "fs.write:~"
  ],
  "contributes": {
    "window": {
      "width": 1240,
      "height": 760
    },
    "fileTypes": [
      "lsproj",
      "lsch",
      "lsui",
      "lsapp"
    ]
  },
  "entry": "dist/index.js",
  "styles": [
    "dist/index-BogtuFYA.css"
  ],
  "locales": "locales.json",
