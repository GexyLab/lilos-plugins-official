{
  "id": "automata",
  "version": "1.1.0",
  "kind": "local",
  "name": "Automata",
  "description": "Record what you do in lilOS and do it again with a click: each step can ask for confirmation, or for its values, before it runs.",
  "category": "productivity",
  "icon": {
    "glyph": "automation",
    "color": "#7a4fd6"
  },
  "publisher": {
    "id": "lilos",
    "name": "lilOS"
  },
  "sdk": "2",
  "system": true,
  "lilos": ">=1.17.0",
  "entrypoints": {
    "main": {
      "kind": "window",
      "params": {
        "file": {
          "type": "file",
          "label": "Automation",
          "description": "The automation to open"
        }
      }
    },
    "recorder": {
      "kind": "window",
      "label": "Recorder"
    },
    "run": {
      "kind": "window",
      "label": "Run an automation"
    },
    "cli": {
      "kind": "background",
      "label": "Terminal command"
    }
  },
  "permissions": [
    "fs.write:~"
  ],
  "contributes": {
    "window": {
      "width": 1060,
      "height": 620
    },
    "fileTypes": [
      "automata"
    ],
    "shell": [
      {
        "name": "automata",
        "entry": "cli",
        "help": true,
        "summary": "Lists and runs your automations",
        "usage": "automata list | automata run <name> [file…] [--field=value…] [--yes]"
      }
    ]
  },
  "entry": "dist/index.js",
  "styles": [
    "dist/index-Crufyhex.css"
  ],
  "locales": "locales.json",
  "files": {
    "dist/index-Crufyhex.css": "sha256-r1xlxYeH/ls7VcjDbonMM8eq1eVzb4IouJnXUW1jeMk=",
    "dist/index.js": "sha256-C+vdnPbjbubMr8xlTSnAEDloAvEPn3JOsMhc7XaUecc=",
    "locales.json": "sha256-Us8Qhtx5JapE4bs8JpD4XdY7vkI1CLm7biOtryFkQS4="
  }
}
