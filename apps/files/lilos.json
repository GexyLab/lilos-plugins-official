{
  "id": "files",
  "version": "1.9.0",
  "kind": "local",
  "name": "File Manager",
  "description": "Browse, search and organize files and folders: tags, links, trash, info and preview.",
  "category": "system",
  "icon": {
    "glyph": "folder",
    "color": "#3b6ef5"
  },
  "publisher": {
    "id": "lilos",
    "name": "lilOS"
  },
  "sdk": "1",
  "system": true,
  "required": true,
  "entrypoints": {
    "main": {
      "kind": "window",
      "params": {
        "folder": {
          "type": "folder",
          "label": "Folder",
          "description": "The folder it shows when it opens"
        }
      }
    }
  },
  "permissions": [
    "fs.write:~",
    "fs.workspaces",
    "tags.write",
    "desktop.items",
    "ui.shortcuts"
  ],
  "contributes": {
    "window": {
      "width": 1000,
      "height": 520
    },
    "commands": [
      {
        "id": "files.info",
        "label": "Show or hide the info panel",
        "keys": [
          "Alt+I"
        ]
      },
      {
        "id": "files.preview",
        "label": "Show or hide the preview",
        "keys": [
          "Alt+P"
        ]
      },
      {
        "id": "files.address",
        "label": "Type a path",
        "keys": [
          "Ctrl+L"
        ]
      }
    ]
  },
  "entry": "dist/index.js",
  "styles": [
    "dist/index-DcVAajn1.css"
  ],
  "locales": "locales.json",
  "files": {
    "dist/index-DcVAajn1.css": "sha256-Ks08AVj/xilKxNdMmZXCdq3SSUsHgiLHMS/A5b1Csis=",
    "dist/index.js": "sha256-yw3jLySnhWMpy7w63s20DrQJtPfHhG+sLWMdJ3qM3HU=",
    "locales.json": "sha256-v/oA9jBjecWxHK9vZLPDJuxukerVTFFkfJx2TGiwGHU="
  }
}
